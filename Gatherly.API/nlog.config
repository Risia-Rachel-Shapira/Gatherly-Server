<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<!-- Layout renderers such as ${aspnet-TraceIdentifier}. -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<!--
		Minimum level for application logs: Debug in Development,
		Info everywhere else (based on ASPNETCORE_ENVIRONMENT).
	-->
	<variable name="appMinLevel"
	          value="${when:when='${environment:ASPNETCORE_ENVIRONMENT}'=='Development':inner=Debug:else=Info}" />

	<!--
		CorrelationId = HttpContext.TraceIdentifier. CorrelationIdMiddleware
		sets it from the X-Correlation-ID header (or a new GUID), so it is
		the same value returned to the client and in error responses.
		ignoreActivityId=true: use TraceIdentifier, not the W3C Activity id.
	-->
	<variable name="layout"
	          value="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${aspnet-TraceIdentifier:ignoreActivityId=true:whenEmpty=NoCorrelationId}|${message} ${exception:format=tostring}" />

	<targets>
		<target xsi:type="Console" name="console" layout="${layout}" />

		<target xsi:type="File"
                name="file"
                fileName="${basedir}/logs/gatherly-${shortdate}.log"
                layout="${layout}" />
	</targets>

	<rules>
		<!-- Startup messages (listening URLs, environment). -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

		<!--
			Framework logs: warnings and above only. These rules drop anything
			below Warn (no writeTo + final); Warn and above continue to the
			catch-all rule. (A minlevel=Warn rule with final would not stop
			Debug/Info events, because final applies only when a rule matches.)
		-->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<logger name="*" minlevel="${var:appMinLevel}" writeTo="console,file" />
	</rules>

</nlog>
